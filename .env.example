# Copy this file to .env and provide rotated, private values locally.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/ai_chat"
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
REDIS_URL="redis://localhost:6379"
UPLOAD_DIR="/tmp/uploads"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Xiaomi MiMo exposes an OpenAI-compatible endpoint.
MIMO_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
MIMO_API_KEY="REPLACE_WITH_ROTATED_MIMO_KEY"
MIMO_MODEL="mimo-v2.5"
MIMO_PRO_MODEL="mimo-v2.5-pro"

# Volcengine Ark OpenAI-compatible gateway.
VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
VOLCENGINE_API_KEY="REPLACE_WITH_ROTATED_VOLCENGINE_KEY"
ARK_API_KEY="REPLACE_WITH_ROTATED_VOLCENGINE_KEY"
VOLCENGINE_DEEPSEEK_V4_PRO_ENDPOINT="ep-REPLACE_WITH_DEEPSEEK_ENDPOINT_ID"
VOLCENGINE_DEEPSEEK_V4_PRO_MODEL="DeepSeek-V4-pro"
VOLCENGINE_IMAGE_ENDPOINT="ep-REPLACE_WITH_IMAGE_ENDPOINT_ID"
VOLCENGINE_IMAGE_MODEL="Doubao-Seedream-5.0-lite"
VOLCENGINE_IMAGE_API_MODEL="doubao-seedream-5-0-260128"
VOLCENGINE_SEEDREAM_4_0_ENDPOINT="ep-REPLACE_WITH_SEEDREAM_4_0_ENDPOINT_ID"
VOLCENGINE_SEEDREAM_4_0_API_KEY="REPLACE_WITH_ROTATED_VOLCENGINE_KEY"
VOLCENGINE_SEEDREAM_4_0_API_MODEL="doubao-seedream-4-0-250828"
VOLCENGINE_SEEDREAM_4_5_ENDPOINT="ep-REPLACE_WITH_SEEDREAM_4_5_ENDPOINT_ID"
VOLCENGINE_SEEDREAM_4_5_API_KEY="REPLACE_WITH_ROTATED_VOLCENGINE_KEY"
VOLCENGINE_SEEDREAM_4_5_API_MODEL="doubao-seedream-4-5-251128"
VOLCENGINE_VIDEO_ENDPOINT="ep-REPLACE_WITH_VIDEO_ENDPOINT_ID"
VOLCENGINE_VIDEO_MODEL="Seedance 1.0 Fast"
VOLCENGINE_VIDEO_API_MODEL="ep-REPLACE_WITH_VIDEO_ENDPOINT_ID"
VOLCENGINE_VIDEO_T2V_MODEL="REPLACE_WITH_OPTIONAL_SEEDANCE_T2V_MODEL_OR_LEAVE_UNSET"
VOLCENGINE_VIDEO_I2V_MODEL="REPLACE_WITH_OPTIONAL_SEEDANCE_I2V_MODEL_OR_LEAVE_UNSET"
VOLCENGINE_AGENT_ENDPOINT="ep-REPLACE_WITH_AGENT_ENDPOINT_ID"
VOLCENGINE_AGENT_MODEL="Doubao-Seed-2.0-lite"
VOLCENGINE_AGENT_API_MODEL="ep-REPLACE_WITH_AGENT_ENDPOINT_ID"
VOLCENGINE_AUDIO_ENDPOINT="ep-REPLACE_WITH_AUDIO_ENDPOINT_ID"
VOLCENGINE_AUDIO_MODEL="Doubao-Seed-2.0-mini"
VOLCENGINE_AUDIO_API_MODEL="ep-REPLACE_WITH_AUDIO_ENDPOINT_ID"

# Agnes AI - 免费全模态模型
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_API_KEY="REPLACE_WITH_AGNES_API_KEY"
